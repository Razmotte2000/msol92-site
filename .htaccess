# Apache config for Hostinger (mirrors vercel.json behaviour)

RewriteEngine On

# Canonical: strip .html from URLs (single-page site served at /)
RewriteCond %{THE_REQUEST} \s/+[^?\s]*\.html[\s?] [NC]
RewriteRule ^ / [R=301,L]

# Force HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

<IfModule mod_headers.c>
  # Immutable long-cache for images (mirrors vercel.json headers)
  <FilesMatch "\.(webp|png|jpe?g|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # HTML must revalidate so content updates are picked up
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript image/svg+xml
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
</IfModule>

<IfModule mod_headers.c>
  # En-têtes de sécurité
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
</IfModule>

# Bloque l'accès aux fichiers sensibles
<FilesMatch "^\.|\.(env|ini|log|sh|sql|bak|old|zip|gz)$">
  Require all denied
</FilesMatch>

# Pas de listing de répertoire
Options -Indexes

ErrorDocument 404 /index.html
