# Apache config for Hostinger (mirrors vercel.json behaviour)

RewriteEngine On

# index.html -> version sans index.html (/ et /blog/)
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^(.*)index\.html$ /$1 [R=301,L]

# Site one-page : une page .html POSEE A LA RACINE renvoie vers l'accueil.
# La condition ^/[^/]+\.html$ limite la regle au premier niveau : /blog/,
# /services/ et toute future sous-section gardent leurs URLs propres.
# Seul le fichier de validation Google reste servi tel quel a la racine.
RewriteCond %{THE_REQUEST} \s/+[^?\s]*\.html[\s?] [NC]
RewriteCond %{REQUEST_URI} ^/[^/]+\.html$
RewriteCond %{REQUEST_URI} !^/google[0-9a-f]+\.html$ [NC]
RewriteRule ^ / [R=301,L]

# Domaine canonique : force HTTPS + non-www + msol92.com, en une seule redirection.
# Couvre aussi msol92.fr si le domaine est un jour repointe sur cet hebergement.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^msol92\.com$ [NC]
RewriteRule ^ https://msol92.com%{REQUEST_URI} [R=301,L]

<IfModule mod_headers.c>
  # Immutable long-cache for images (mirrors vercel.json headers)
  <FilesMatch "\.(webp|png|jpe?g|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # HTML must revalidate so content updates are picked up
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript image/svg+xml
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
</IfModule>

<IfModule mod_headers.c>
  # En-têtes de sécurité
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
</IfModule>

# Bloque l'accès aux fichiers sensibles
<FilesMatch "^\.|\.(env|ini|log|sh|sql|bak|old|zip|gz)$">
  Require all denied
</FilesMatch>

# Pas de listing de répertoire
Options -Indexes

ErrorDocument 404 /index.html
